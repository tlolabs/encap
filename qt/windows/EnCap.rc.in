1 ICON "@ENCAP_WINDOWS_ICON@"

// FileVersionInfo reads this resource, rather than the assembly manifest.
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "TLO Labs\0"
   VALUE "FileDescription", "EnCap\0"
   VALUE "FileVersion", "@ENCAP_VERSION@.0\0"
   VALUE "InternalName", "EnCap\0"
   VALUE "OriginalFilename", "EnCap.exe\0"
   VALUE "ProductName", "EnCap\0"
   VALUE "ProductVersion", "@ENCAP_VERSION@.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
