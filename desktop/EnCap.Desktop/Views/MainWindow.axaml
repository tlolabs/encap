<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:EnCap" x:Class="EnCap.MainWindow" Title="{Binding WindowTitle}" Width="1180" Height="820" MinWidth="800" MinHeight="580" DragDrop.AllowDrop="True">
 <Window.KeyBindings><KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/><KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/><KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/><KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}"/><KeyBinding Gesture="Ctrl+1" Command="{Binding AudioCommand}"/><KeyBinding Gesture="Ctrl+2" Command="{Binding TranscriptCommand}"/><KeyBinding Gesture="Ctrl+3" Command="{Binding VideoCommand}"/></Window.KeyBindings>
 <DockPanel>
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="_File">
    <MenuItem x:Name="ImportMenu" Header="_Import Folder…" Command="{Binding ImportCommand}" InputGesture="Ctrl+I"/>
    <MenuItem x:Name="OpenMenu" Header="_Open Project…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O"/>
    <MenuItem x:Name="SaveMenu" Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S"/>
    <MenuItem x:Name="SaveAsMenu" Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S"/>
    <Separator/>
    <MenuItem Header="Export Audio…" Command="{Binding ExportAudioCommand}"/>
    <MenuItem Header="Export Text…" Command="{Binding ExportTextCommand}"/>
    <MenuItem Header="Export SRT…" Command="{Binding ExportSrtCommand}"/>
    <MenuItem Header="Export MP4…" Command="{Binding ExportVideoCommand}"/>
   </MenuItem>
   <MenuItem Header="_Mode">
    <MenuItem x:Name="AudioMenu" Header="_Audio" Command="{Binding AudioCommand}" InputGesture="Ctrl+1"/>
    <MenuItem x:Name="TranscriptMenu" Header="_Transcript" Command="{Binding TranscriptCommand}" InputGesture="Ctrl+2"/>
    <MenuItem x:Name="VideoMenu" Header="_Video" Command="{Binding VideoCommand}" InputGesture="Ctrl+3"/>
   </MenuItem>
   <MenuItem Header="_Application">
    <MenuItem x:Name="CheckUpdatesMenu" Header="Check for Updates…" Click="CheckUpdates"/>
    <MenuItem x:Name="AutomaticUpdatesMenu" Header="Automatically Check for Updates" ToggleType="CheckBox" IsChecked="True" Click="ToggleUpdates"/>
    <Separator/>
    <MenuItem Header="_Appearance">
     <MenuItem x:Name="ThemeSystemMenu" Header="_System" ToggleType="Radio" Click="ThemeSystem"/>
     <MenuItem x:Name="ThemeLightMenu" Header="_Light" ToggleType="Radio" Click="ThemeLight"/>
     <MenuItem x:Name="ThemeDarkMenu" Header="_Dark" ToggleType="Radio" Click="ThemeDark"/>
    </MenuItem>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Bottom" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeBorderLowBrush}"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="Application status" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="OperationProgress" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" AutomationProperties.Name="Operation in progress"/></StackPanel><Button Grid.Column="1" Content="Cancel" IsVisible="{Binding IsBusy}" Command="{Binding CancelCommand}" Margin="12,0,0,0"/></Grid></Border>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="16,8"><Button Content="Import Folder…" Command="{Binding ImportCommand}"/><Button Content="Open Project…" Command="{Binding OpenCommand}"/><Button Content="Save" Command="{Binding SaveCommand}"/><Separator/><Button Content="Audio" Command="{Binding AudioCommand}"/><Button Content="Transcript" Command="{Binding TranscriptCommand}"/><Button Content="Video" Command="{Binding VideoCommand}"/></StackPanel>
  <Grid Margin="16,8" IsEnabled="{Binding IsIdle}">
   <Grid IsVisible="{Binding IsAudio}" ColumnDefinitions="240,12,*">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="Recordings" Classes="heading" Margin="0,0,0,8"/>
     <StackPanel DockPanel.Dock="Bottom" Spacing="6"><WrapPanel><Button Content="Add…" Command="{Binding AddFilesCommand}"/><Button Content="Remove…" Click="RemoveSources" IsEnabled="{Binding HasProject}"/><Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="{Binding PlaybackLabel}" Command="{Binding PlayCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/></WrapPanel><Slider x:Name="SourceSeek" Minimum="0" Maximum="{Binding PlaybackDuration}" Value="{Binding PlaybackPosition,Mode=OneWay}" PointerReleased="SeekReleased" KeyUp="SeekKeyUp" AutomationProperties.Name="Recording position"/><TextBlock Text="{Binding PlaybackTime}"/><TextBlock Text="Space: play/pause · J/K/L: shuttle&#10;Hold K with J/L: half speed" TextWrapping="Wrap" FontSize="12"/></StackPanel>
     <ListBox x:Name="SourceList" ItemsSource="{Binding Sources}" SelectedItems="{Binding SelectedSources}" SelectionMode="Multiple" DoubleTapped="SourceDoubleTapped" KeyDown="SourceKeyDown" KeyUp="SourceKeyUp" AutomationProperties.Name="Source recordings">
      <ListBox.ContextMenu><ContextMenu><MenuItem Header="Play / Pause" Command="{Binding PlayCommand}"/><MenuItem Header="Add Audio Files…" Command="{Binding AddFilesCommand}"/><MenuItem Header="Remove Selected Recordings…" Click="RemoveSources"/></ContextMenu></ListBox.ContextMenu>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6" Spacing="4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/><TextBlock Text="{Binding Detail}" FontSize="12"/><local:Waveform Peaks="{Binding Peaks}" Height="18"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns" AutomationProperties.Name="Resize recordings column"/>
    <ScrollViewer Grid.Column="2"><StackPanel Spacing="10" IsEnabled="{Binding HasProject}">
     <TextBlock Text="Episode" Classes="heading"/>
     <Grid ColumnDefinitions="*,160"><StackPanel Margin="0,0,16,0"><TextBlock Text="Podcast title" Classes="label"/><TextBox x:Name="PodcastTitle" Text="{Binding Project.Metadata.PodcastTitle,Mode=TwoWay}" AutomationProperties.Name="Podcast title"/><TextBlock Text="Episode title" Classes="label"/><TextBox x:Name="EpisodeTitle" Text="{Binding Project.Metadata.EpisodeTitle,Mode=TwoWay}" AutomationProperties.Name="Episode title"/><TextBlock Text="Summary" Classes="label"/><TextBox Text="{Binding Project.Metadata.Summary,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.Name="Episode summary"/></StackPanel><StackPanel Grid.Column="1"><Image Source="{Binding Project.Metadata.ArtworkPath,Converter={StaticResource LocalImage}}" Height="160" Stretch="Uniform" AutomationProperties.Name="Episode artwork"/><Button Content="Artwork…" Command="{Binding ArtworkCommand}"/></StackPanel></Grid>
     <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Format" Classes="label"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Project.ExportSettings.OutputFormat,Mode=TwoWay}" AutomationProperties.Name="Audio format"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Channels" Classes="label"/><ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Project.ExportSettings.Channels,Mode=TwoWay}" AutomationProperties.Name="Audio channels"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Bitrate" Classes="label"/><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Project.ExportSettings.QualityPreset,Mode=TwoWay}" AutomationProperties.Name="Audio bitrate"/></StackPanel><Button Content="Export Audio…" Command="{Binding ExportAudioCommand}" VerticalAlignment="Bottom"/></WrapPanel>
     <TextBlock Text="Chapters" Classes="heading" Margin="0,12,0,0"/><WrapPanel><ComboBox ItemsSource="{Binding NamingStyles}" SelectedItem="{Binding Naming,Mode=TwoWay}" AutomationProperties.Name="Chapter naming style"/><Button Content="Apply Names" Command="{Binding NameChaptersCommand}"/><Button Content="Add" Command="{Binding AddChapterCommand}"/><Button Content="Remove" Command="{Binding RemoveChapterCommand}"/><Button Content="Chapter Artwork…" Command="{Binding ChapterArtworkCommand}"/></WrapPanel>
     <ListBox x:Name="ChapterList" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter,Mode=TwoWay}" MinHeight="130" AutomationProperties.Name="Project chapters"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="28,*,100" Margin="0,4"><TextBlock Text="{Binding DisplayNumber}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="4,0,8,0"><TextBox Text="{Binding Title,Mode=TwoWay}" AutomationProperties.Name="Chapter title"/><TextBox Text="{Binding LinkUrl,Mode=TwoWay}" PlaceholderText="Chapter link" AutomationProperties.Name="Chapter link"/></StackPanel><NumericUpDown Grid.Column="2" Value="{Binding DurationSeconds,Mode=TwoWay}" Minimum="0.001" FormatString="0.###" AutomationProperties.Name="Chapter duration in seconds"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </StackPanel></ScrollViewer>
   </Grid>
   <ScrollViewer IsVisible="{Binding IsTranscript}"><StackPanel Spacing="12">
    <TextBlock Text="Transcript" Classes="heading"/><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider,Mode=TwoWay}" AutomationProperties.Name="Local transcription engine"/><WrapPanel><Button Content="Transcribe Locally" Command="{Binding TranscribeCommand}"/><Button Content="Refresh Models" Command="{Binding ModelsCommand}"/><Button Content="Export Text…" Command="{Binding ExportTextCommand}"/><Button Content="Export SRT…" Command="{Binding ExportSrtCommand}"/><CheckBox Content="Word timestamps" IsChecked="{Binding Project.TranscriptSettings.IncludeWordTimestamps,Mode=TwoWay}"/></WrapPanel>
    <Expander Header="Local transcription models"><StackPanel Spacing="8"><TextBlock Text="Models use the existing verified local model catalog."/><ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel,Mode=TwoWay}" MaxHeight="220" AutomationProperties.Name="Local models"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding DownloadSize}"/><TextBlock Text="{Binding Languages}"/><CheckBox Content="Installed" IsChecked="{Binding Installed,Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Download Selected" Command="{Binding InstallModelCommand}"/><Button Content="Remove Selected" Command="{Binding RemoveModelCommand}"/></StackPanel></StackPanel></Expander>
    <ItemsControl ItemsSource="{Binding Segments}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="130,*" Margin="0,4"><TextBox Text="{Binding Speaker,Mode=TwoWay}" PlaceholderText="Speaker" AutomationProperties.Name="Transcript speaker"/><TextBox Grid.Column="1" Text="{Binding Text,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Margin="8,0,0,0" AutomationProperties.Name="Transcript text"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer>
   <Grid IsVisible="{Binding IsVideo}" RowDefinitions="*,Auto" IsEnabled="{Binding HasProject}">
   <ScrollViewer Grid.Row="0"><StackPanel Spacing="12">
    <TextBlock Text="Video" Classes="heading"/><TextBlock Text="Create an MP4 from the project's original chapter audio and artwork."/>
    <Expander IsExpanded="False">
     <Expander.Header><StackPanel><TextBlock Text="Chapter selection" FontWeight="SemiBold"/><TextBlock Text="{Binding VideoChapterSummary}" FontSize="12"/></StackPanel></Expander.Header>
     <StackPanel Spacing="8">
    <WrapPanel><Button Content="Select All" Command="{Binding SelectAllCommand}"/><Button Content="Select None" Command="{Binding SelectNoneCommand}"/><Button Content="Move Up" Command="{Binding MoveUpCommand}"/><Button Content="Move Down" Command="{Binding MoveDownCommand}"/></WrapPanel>
    <ListBox x:Name="VideoList" ItemsSource="{Binding VideoChapters}" SelectedItem="{Binding SelectedVideo,Mode=TwoWay}" MaxHeight="220" DoubleTapped="VideoDoubleTapped" DragDrop.AllowDrop="True" PointerPressed="VideoDragStart" PointerMoved="VideoDragMove" AutomationProperties.Name="Video chapter order"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="12"><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" AutomationProperties.Name="{Binding Chapter.Title}"><TextBlock Text="{Binding Chapter.Title}"/></CheckBox><TextBlock Text="{Binding Chapter.DurationSeconds,StringFormat='{}{0:0.##} seconds'}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Text="{Binding VideoDuration,StringFormat='Total selected duration: {0:0.##} seconds'}"/>
     </StackPanel>
    </Expander>
    <StackPanel><TextBlock Text="Social preset" Classes="label"/><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset,Mode=TwoWay}" AutomationProperties.Name="Social video preset"/></StackPanel>
    <Expander IsExpanded="False">
     <Expander.Header><StackPanel><TextBlock Text="Advanced format" FontWeight="SemiBold"/><TextBlock Text="{Binding VideoFormatSummary}" FontSize="12"/></StackPanel></Expander.Header>
     <StackPanel Spacing="8">
    <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Codec" Classes="label"/><ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding Project.Video.ExportSettings.Codec,Mode=TwoWay}" AutomationProperties.Name="Video codec"/></StackPanel><StackPanel><TextBlock Text="Encoding" Classes="label"/><ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding Project.Video.ExportSettings.Encoding,Mode=TwoWay}" AutomationProperties.Name="Video encoding"/></StackPanel></WrapPanel>
    <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Width" Classes="label"/><NumericUpDown Value="{Binding Project.Video.ExportSettings.Width,Mode=TwoWay}" Minimum="2" Maximum="8192" Increment="2" AutomationProperties.Name="Video width"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Height" Classes="label"/><NumericUpDown Value="{Binding Project.Video.ExportSettings.Height,Mode=TwoWay}" Minimum="2" Maximum="8192" Increment="2" AutomationProperties.Name="Video height"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="FPS" Classes="label"/><NumericUpDown Value="{Binding Project.Video.ExportSettings.Fps,Mode=TwoWay}" Minimum="1" Maximum="120" AutomationProperties.Name="Video frame rate"/></StackPanel><StackPanel><TextBlock Text="Audio bitrate" Classes="label"/><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Project.Video.ExportSettings.AudioBitrate,Mode=TwoWay}" AutomationProperties.Name="Video audio bitrate"/></StackPanel></WrapPanel>
     </StackPanel>
    </Expander>
    <Expander IsExpanded="False">
     <Expander.Header><StackPanel><TextBlock Text="Artwork and preview options" FontWeight="SemiBold"/><TextBlock Text="{Binding VideoArtworkSummary}" FontSize="12"/></StackPanel></Expander.Header>
    <WrapPanel><CheckBox Content="Flip horizontally" IsChecked="{Binding Project.Video.ExportSettings.FlipHorizontal,Mode=TwoWay}" Margin="0,0,12,0"/><CheckBox Content="Flip vertically" IsChecked="{Binding Project.Video.ExportSettings.FlipVertical,Mode=TwoWay}" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding PreviewQualities}" SelectedItem="{Binding Project.Video.ExportSettings.PreviewQuality,Mode=TwoWay}" AutomationProperties.Name="Preview quality"/></WrapPanel>
    </Expander>
    <Border Background="Black" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" HorizontalAlignment="Left"><Grid><Grid.RenderTransform><ScaleTransform ScaleX="{Binding FlipX}" ScaleY="{Binding FlipY}"/></Grid.RenderTransform><Image Source="{Binding PreviewArtwork,Converter={StaticResource LocalImage}}" Stretch="UniformToFill" Opacity="0.45"/><Image Source="{Binding PreviewArtwork,Converter={StaticResource LocalImage}}" Stretch="Uniform" AutomationProperties.Name="Video artwork preview"/></Grid></Border>
    <Slider x:Name="VideoSeek" Minimum="0" Maximum="{Binding VideoDuration}" Value="{Binding PlaybackPosition,Mode=OneWay}" PointerReleased="SeekReleased" KeyUp="SeekKeyUp" AutomationProperties.Name="Video timeline position"/>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="{Binding PlaybackLabel}" Command="{Binding PlayCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/><TextBlock Text="{Binding PlaybackTime}" VerticalAlignment="Center"/></StackPanel>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"><Button Content="Select All Chapters" Command="{Binding SelectAllCommand}"/><Button Content="Episode Artwork…" Command="{Binding ArtworkCommand}"/><TextBlock Text="Artwork required" IsVisible="{Binding NeedsVideoArtwork}" VerticalAlignment="Center"/><Button Content="Export MP4…" Command="{Binding ExportVideoCommand}" HorizontalAlignment="Right"/></StackPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
